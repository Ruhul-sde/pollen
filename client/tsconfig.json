{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "react": ["./node_modules/.pnpm/@types+react@18.3.12/node_modules/@types/react"],
      "react/*": ["./node_modules/.pnpm/@types+react@18.3.12/node_modules/@types/react/*"],
      "react-dom": ["./node_modules/.pnpm/@types+react-dom@18.3.1/node_modules/@types/react-dom"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/.pnpm/@types+react@18.3.12/node_modules/@types",
      "./node_modules/.pnpm/@types+react-dom@18.3.1/node_modules/@types"
    ]
  },
  "include": ["src"]
}
