# ─── Server Configuration ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/pollen_db
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/pollen_db?retryWrites=true&w=majority

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Use strong random strings (e.g. openssl rand -base64 64)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ─── Admin Credentials (seeded on first start) ───────────────────────────────
ADMIN_EMAIL=admin@pollen.com
ADMIN_PASSWORD=change_this_in_production

# ─── Client Origin (for CORS) ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Razorpay Payment Gateway ────────────────────────────────────────────────
# From dashboard.razorpay.com -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Cloudinary (for image uploads) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email (Nodemailer via Gmail or SMTP) ────────────────────────────────────
# For Gmail: use App Password (not your regular password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=noreply@pollenstore.in
# Or custom SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password